# ─────────────────────────────────────────────────────────────
# Study Buddy — client environment variables
# Copy this file to `.env` (same folder) if you want to change the defaults.
#
# ⚠️ Every VITE_* variable is baked into the PUBLIC JavaScript that browsers download.
#    NEVER put secrets here (no bot token, no database URI, no JWT secret).
# ─────────────────────────────────────────────────────────────

# Base URL for API calls. Keep it as /api:
#  - in development, Vite's proxy forwards /api to http://localhost:5000
#  - in production, client/vercel.json rewrites /api to the Render server
VITE_API_URL=/api

# Display name of the app (optional).
VITE_APP_NAME=Study Buddy
