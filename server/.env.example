# ─────────────────────────────────────────────────────────────
# Study Buddy — server environment variables
# Copy this file to `.env` (same folder) and fill in real values.
# NEVER commit .env — it contains secrets. This example file is safe to commit.
# ─────────────────────────────────────────────────────────────

# Port the API listens on. Render sets this automatically in production.
PORT=5000

# "development" locally, "production" on Render (turns on secure cookies, hides error details).
NODE_ENV=development

# MongoDB Atlas connection string (SECRET). From Atlas → Connect → Drivers.
# Put the database name "studybuddy" after the host, before the "?".
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/studybuddy?retryWrites=true&w=majority

# Secret used to sign login tokens (SECRET). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# How long a login lasts before the user must log in again.
JWT_EXPIRES_IN=7d

# The frontend's URL — the only origin allowed by CORS.
# Local: http://localhost:5173   Production: https://<your-app>.vercel.app
CLIENT_URL=http://localhost:5173

# Telegram bot token from @BotFather (SECRET).
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-bot-token

# Your bot's username WITHOUT the @. Used to build the "Connect Telegram" link t.me/<username>?start=…
TELEGRAM_BOT_USERNAME=your_bot_username

# Secret Telegram sends back in a header on every webhook call, so we know it's really Telegram (SECRET).
# 16–256 characters: letters, numbers, _ or -. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-hex-string

# (Supporters connect their own Telegram in the app, so there is no fixed chat ID anymore.)

# Secret that cron-job.org must send in the "x-cron-secret" header to call /api/jobs/* (SECRET).
# Generate the same way as JWT_SECRET (a different value!).
CRON_SECRET=replace-with-another-long-random-string

# Sessions running longer than this many hours are auto-stopped.
AUTO_STOP_HOURS=4
